from flask import Flask, request, jsonify
import requests
import os
from dotenv import load_dotenv  # Для локального тестирования

# Загружаем переменные окружения (если запускаем локально)
# На Vercel они подхватываются автоматически из настроек проекта
load_dotenv()

app = Flask(__name__)

# --- Конфигурация (берем из переменных окружения) ---
YOUGILE_API_TOKEN = os.getenv('https://ru.yougile.com/team/0eecfb2fd138/заявки-ЦППМСП') # https://ru.yougile.com/team/0eecfb2fd138/заявки-ЦППМСП
YOUGILE_COLUMN_ID = os.getenv('1e0f55ba-e680-47f7-980c-2315364097e0')
YOUGILE_API_URL = 'https://ru.yougile.com/api-v2/tasks'


# --- Обработчик POST-запросов ---
@app.route('/api/webhook', methods=['POST'])
def handle_webhook():
    if not YOUGILE_API_TOKEN or not YOUGILE_COLUMN_ID:
        print("Ошибка: Не установлены переменные окружения YOUGILE_TOKEN или YOUGILE_COLUMN_ID")
        return jsonify({"error": "Server configuration error"}), 500

    data = request.get_json()

    if not data or 'values' not in data:
        print(f"Ошибка: Некорректный формат данных от Яндекс Форм: {data}")
        return jsonify({"error": "Bad Request: Invalid data format"}), 400

    form_values = data['values']

    # --- Адаптация данных под YouGile ---
    # Вам нужно будет посмотреть, какие ключи приходят от Яндекс Форм
    # и подставить их сюда. Например, если поле называется 'user_name', то form_values.get('user_name')

    # Пример: предполагаем, что в Яндекс Формах есть поля 'task_title', 'user_name', 'details'
    task_title = form_values.get('task_title', 'Новая заявка')  # Поле для заголовка задачи
    user_name = form_values.get('user_name', 'Неизвестный')  # Поле для имени пользователя
    details = form_values.get('details', 'Нет деталей')  # Поле для описания

    yougile_task_data = {
        'title': task_title,
        'columnId': YOUGILE_COLUMN_ID,
        'description': f"--- Информация из формы ---\n"
                       f"От: {user_name}\n"
                       f"Детали:\n{details}\n"
                       f"--------------------------\n"
                       f"Полные данные:\n{dict(form_values)}"  # Для отладки, чтобы видеть всё
    }

    # --- Отправка в YouGile ---
    try:
        headers = {
            'Authorization': f'Bearer {YOUGILE_API_TOKEN}',
            'Content-Type': 'application/json'
        }
        response = requests.post(YOUGILE_API_URL, json=yougile_task_data, headers=headers)
        response.raise_for_status()  # Выбросит исключение для плохих ответов (4xx или 5xx)

        print(f"Задача успешно создана в YouGile. Ответ: {response.json()}")
        return jsonify({"message": "Success", "yougile_response": response.json()}), 200

    except requests.exceptions.RequestException as e:
        print(f"Ошибка при отправке в YouGile: {e}")
        # Можно вернуть детали ошибки от YouGile, если они есть
        error_details = e.response.json() if e.response and hasattr(e.response, 'json') else str(e)
        return jsonify({"error": "Failed to create task in YouGile", "details": error_details}), 500
    except Exception as e:
        print(f"Непредвиденная ошибка: {e}")
        return jsonify({"error": "An unexpected error occurred"}), 500


# --- Код для локального запуска (не будет использоваться на Vercel, но полезен для тестов) ---
if __name__ == '__main__':
    # Убедись, что у тебя выставлены YOUGILE_TOKEN и YOUGILE_COLUMN_ID в .env файле
    # или в переменных окружения вашей ОС, если запускаешь локально.
    # Пример:
    # YOUGILE_TOKEN=ваш_токен
    # YOUGILE_COLUMN_ID=ваш_id_колонки
    #
    # Затем запускай командой: python api/webhook.py
    # Vercel же сам вызовет эту функцию без блока if __name__ == '__main__'

    # Убедись, что порт 8000 (или другой) свободен
    # На Vercel будет использоваться другой механизм запуска
    port = int(os.environ.get('PORT', 8000))  # Vercel может использовать PORT env variable
    app.run(host='0.0.0.0', port=port, debug=True)
